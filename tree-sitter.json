{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sclang_parser",
      "camelcase": "SclangParser",
      "title": "SuperCollider Language Parser",
      "scope": "source.sclang_parser",
      "file-types": [
        "sclang_parser"
      ],
      "injection-regex": "^sclang_parser$",
      "class-name": "TreeSitterSclangParser"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for the SuperCollider Programming Language",
    "authors": [
      {
        "name": "Mads Kjeldgaard"
      }
    ],
    "links": {
      "repository": "https://github.com/john-d-murphy/tree-sitter-supercollider"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}